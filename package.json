{
  "name": "train-ticket",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "Electron Train Ticket App",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist --nojekyll --remove \"**/*\"",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "electron:dev": "concurrently \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:5173 && electron .\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0", 
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3", 
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "gh-pages": "^6.0.0", 
    "vite": "^5.0.0",
    "vite-plugin-vue-devtools": "^7.0.0", 
    "wait-on": "^7.2.0"
  }
}
